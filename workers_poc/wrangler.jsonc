{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lonklar-python-poc",
  "main": "src/entry.py",
  "account_id": "585ac81ae021c1bcd59e429e7a6af1ac",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "lonklar-python-poc",
      "database_id": "891c9b79-dc3e-4b65-be50-b2233ecdb80b",
      "migrations_dir": "migrations"
    }
  ],
  "base_dir": "src"
}
